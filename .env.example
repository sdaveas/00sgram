# Copy to .env and fill the four required values. Never commit .env.
# Comments stay on their own lines: docker env_file does not reliably strip
# trailing comments.

# --- required ---------------------------------------------------------------
# The `sessionid` cookie from a logged-in instagram.com browser session.
# Password login is refused by Instagram (error_type: needs_upgrade).
IG_SESSION_COOKIE=
APP_PASSWORD=
# >= 32 random bytes: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
APP_SECRET=
# Bearer token for MCP. Root-equivalent.
API_TOKEN=

# --- runtime ----------------------------------------------------------------
# browser = a real logged-in Chromium (recommended; see README step 3)
# mock    = fake data for development and tests
# instagrapi = the old cookie path, needs IG_SESSION_COOKIE
PROVIDER=browser
DATA_DIR=/data
# Host directory mounted at /data. On a Mac or a dev box, ./data beside the repo.
DATA_HOME=./data
BACKUP_DIR=/data/backups
# 1 the moment HTTPS exists
COOKIE_SECURE=0
TZ=Europe/Athens
# 300-86400, seeds settings once
SYNC_INTERVAL=1800
# seconds between DM-list walks for the chat store, 0-86400, 0 = off
CHAT_SYNC_INTERVAL=120
# per cycle, 1-50
SYNC_MAX_PAGES=10
# first run, 1-50
BACKFILL_DAYS=7

# --- settings seeded once ---------------------------------------------------
# 0-10000
VIEW_THRESHOLD_MS=1000
# 1000-30000
TYPES=photo,video,carousel,reel,igtv
HIDE_MUTED=1
STORY_AUTO_ADVANCE=0

# --- media ------------------------------------------------------------------
# 0 = pure proxying
MEDIA_CACHE=1
MEDIA_BUDGET_MB=800
MEDIA_RETENTION_DAYS=30

# PROVIDER=browser: drive a real logged-in Chromium (no cookie copying).
# The profile lives on the data volume and IS the credential.
# Log in once, with the app stopped (two Chromiums on one profile deadlock on
# Chromium's own SingletonLock):
#   docker compose stop web
#   docker run --rm -p 5900:5900 -v /srv/00sgram/data:/data --env-file .env \
#     00sgram:local python -m app.browser_login
# The window closes itself once the login is saved; then start the app again.
BROWSER_PROFILE=
BROWSER_HEADLESS=false

# --- messages (experimental) ------------------------------------------------
# Optional: bot token from @BotFather. Absent = the Telegram surface is off.
# TELEGRAM_TOKEN=
# The one chat the app may speak in: a forum group the bot is a member of
# (negative id, e.g. -1001234567890). Anything else that messages the bot is
# dropped before it is stored.
# TELEGRAM_RELAY_CHAT=


# Seconds between backfill pages. Faster than a person scrolls reads as
# automation; 2 s costs 80 s across a 40-page walk.
BACKFILL_SLEEP=2
